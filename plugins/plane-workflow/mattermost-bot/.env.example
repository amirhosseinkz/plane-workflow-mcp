# Mattermost bot identity. Copy this file to .env and replace every example value.
MATTERMOST_URL=https://chat.example.test
MATTERMOST_BOT_USERNAME=example-bot
MATTERMOST_BOT_TOKEN=
MATTERMOST_ALLOWED_USERNAMES=
MATTERMOST_DM_ONLY=true

# Plane connection. Use a dedicated Plane service-account key where possible.
PLANE_BASE_URL=https://plane.example.test
PLANE_WORKSPACE_SLUG=example-workspace
PLANE_API_KEY=
PLANE_PROJECT_ID=example-project-id
PLANE_PROJECT_IDENTIFIER=EXAMPLE

# Natural-language interpretation through the locally signed-in Codex CLI.
# Sign in once on this Mac with: codex login
CODEX_COMMAND=codex
CODEX_TIMEOUT_SECONDS=120

# Local state. Keep this folder private on the Mac that runs the bot.
BOT_DATA_DIR=./data
DRAFT_TTL_MINUTES=15
